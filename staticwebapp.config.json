{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/api/*", "allowedRoles": ["anonymous"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*", "*.html", "*.js", "*.css", "*.png", "*.svg"]
  },
  "globalHeaders": { "X-Content-Type-Options": "nosniff" }
}
